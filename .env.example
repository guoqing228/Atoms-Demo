# Copy to .env.local and fill in. Without these the app runs the built-in Mock Agent.

# default provider: mock | openai | anthropic
DEFAULT_PROVIDER=mock

# OpenAI-compatible endpoint (OpenAI / DeepSeek / SiliconFlow / Bailian DashScope …)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# mock agent pacing: 0 = instant (tests), 1 = normal
MOCK_SPEED=1
